{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seyro-MP4",
  "version": "0.1.0",
  "identifier": "dev.vdaiki.seyromp4",
  "build": {
    "frontendDist": "../src/frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Seyro-MP4 — Inspector de medios",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "vDaiki-dev",
    "category": "Utility",
    "shortDescription": "Descarga honesta y multiformato, local y sin telemetría",
    "longDescription": "Seyro-MP4 inspecciona pistas reales antes de descargar. Sin calidades inventadas, sin DRM, sin servidores propios.",
    "copyright": "Copyright © 2026 vDaiki-dev",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "es-ES"
      }
    }
  }
}
